<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Connexion + inscription — style EcoTrack / Symfony login (Scene Builder) -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ecotrack.ui.EcoTrackAuthController"
            prefHeight="720.0" prefWidth="1020.0"
            stylesheets="@../css/ecotrack.css">

    <left>
        <fx:include source="include/EcoTrackBrandingPanel.fxml"/>
    </left>

    <center>
        <ScrollPane fitToWidth="true" styleClass="auth-form-scroll" hbarPolicy="NEVER">
            <VBox alignment="TOP_CENTER" styleClass="auth-form-panel">
                <padding>
                    <Insets bottom="28.0" left="24.0" right="24.0" top="28.0"/>
                </padding>

                <StackPane maxWidth="460.0" minWidth="320.0">

                    <!-- ========== PANNEAU CONNEXION ========== -->
                    <VBox fx:id="paneLogin" spacing="0.0" styleClass="auth-card">
                        <padding>
                            <Insets bottom="32.0" left="36.0" right="36.0" top="32.0"/>
                        </padding>

                        <VBox spacing="6.0" alignment="CENTER" styleClass="auth-header">
                            <Label text="Se connecter" styleClass="auth-title"/>
                            <Label text="Connectez-vous avec votre compte EcoTrack" styleClass="auth-subtitle"
                                   wrapText="true" textAlignment="CENTER"/>
                        </VBox>

                        <HBox fx:id="messageBannerLogin" managed="false" visible="false"
                              styleClass="message-banner" spacing="10.0" alignment="CENTER_LEFT">
                            <padding>
                                <Insets bottom="12.0" left="14.0" right="14.0" top="12.0"/>
                            </padding>
                            <Label fx:id="messageLabelLogin" wrapText="true" styleClass="message-banner-text"/>
                        </HBox>

                        <VBox spacing="16.0">
                            <VBox spacing="8.0" styleClass="form-group">
                                <Label text="Adresse email" styleClass="form-label"/>
                                <TextField fx:id="loginEmailField" styleClass="form-input"
                                           promptText="vous@exemple.com"/>
                            </VBox>

                            <VBox spacing="8.0" styleClass="form-group">
                                <Label text="Mot de passe" styleClass="form-label"/>
                                <PasswordField fx:id="loginPasswordField" styleClass="form-input"
                                               promptText="••••••••"/>
                            </VBox>

                            <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="form-actions-inline">
                                <CheckBox fx:id="loginRememberCheck" mnemonicParsing="false" text="Se souvenir de moi"
                                          styleClass="auth-checkbox"/>
                                <Hyperlink fx:id="linkForgotPassword" onAction="#onForgotPasswordClicked"
                                           text="Mot de passe oublié ?" styleClass="auth-hyperlink"/>
                            </HBox>

                            <VBox spacing="6.0" styleClass="captcha-stub-box" alignment="CENTER">
                                <Label text="reCAPTCHA (intégration web à brancher plus tard)" styleClass="captcha-stub-label"/>
                            </VBox>

                            <Button fx:id="buttonLoginSubmit" mnemonicParsing="false" onAction="#onLoginSubmitClicked"
                                    text="Se connecter" styleClass="btn-submit"/>

                            <Separator styleClass="section-separator"/>

                            <HBox spacing="10.0" alignment="CENTER" styleClass="social-row">
                                <Button fx:id="buttonSocialGoogle" mnemonicParsing="false" onAction="#onSocialGoogleClicked"
                                        text="Google" styleClass="btn-social"/>
                                <Button fx:id="buttonSocialFacebook" mnemonicParsing="false" onAction="#onSocialFacebookClicked"
                                        text="Facebook" styleClass="btn-social"/>
                            </HBox>

                            <HBox alignment="CENTER" styleClass="auth-footer-row">
                                <Label text="Pas encore de compte ? " styleClass="auth-footer-text"/>
                                <Hyperlink fx:id="linkGoToRegister" onAction="#onGoToRegisterClicked"
                                           text="Créer un compte" styleClass="auth-hyperlink-strong"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- ========== PANNEAU INSCRIPTION ========== -->
                    <VBox fx:id="paneRegister" spacing="0.0" styleClass="auth-card" visible="false" managed="false">
                        <padding>
                            <Insets bottom="32.0" left="36.0" right="36.0" top="32.0"/>
                        </padding>

                        <VBox spacing="6.0" alignment="CENTER" styleClass="auth-header">
                            <Label text="Créer un compte" styleClass="auth-title"/>
                            <Label text="Rejoignez EcoTrack et suivez votre impact positif" styleClass="auth-subtitle"
                                   wrapText="true" textAlignment="CENTER"/>
                        </VBox>

                        <HBox fx:id="messageBannerRegister" managed="false" visible="false"
                              styleClass="message-banner" spacing="10.0" alignment="CENTER_LEFT">
                            <padding>
                                <Insets bottom="12.0" left="14.0" right="14.0" top="12.0"/>
                            </padding>
                            <Label fx:id="messageLabelRegister" wrapText="true" styleClass="message-banner-text"/>
                        </HBox>

                        <VBox spacing="16.0">
                            <VBox spacing="8.0" styleClass="form-group">
                                <Label text="Nom complet" styleClass="form-label"/>
                                <TextField fx:id="registerNameField" styleClass="form-input"
                                           promptText="Jean Dupont"/>
                            </VBox>

                            <VBox spacing="8.0" styleClass="form-group">
                                <Label text="Adresse email" styleClass="form-label"/>
                                <TextField fx:id="registerEmailField" styleClass="form-input"
                                           promptText="vous@exemple.com"/>
                            </VBox>

                            <VBox spacing="8.0" styleClass="form-group">
                                <Label text="Mot de passe" styleClass="form-label"/>
                                <PasswordField fx:id="registerPasswordField" styleClass="form-input"
                                               promptText="Minimum 8 caractères"/>
                            </VBox>

                            <VBox spacing="8.0" styleClass="form-group">
                                <Label text="Confirmer le mot de passe" styleClass="form-label"/>
                                <PasswordField fx:id="registerPasswordConfirmField" styleClass="form-input"
                                               promptText="Retapez le mot de passe"/>
                            </VBox>

                            <VBox spacing="6.0" styleClass="captcha-stub-box" alignment="CENTER">
                                <Label text="reCAPTCHA (intégration web à brancher plus tard)" styleClass="captcha-stub-label"/>
                            </VBox>

                            <Button fx:id="buttonRegisterSubmit" mnemonicParsing="false" onAction="#onRegisterSubmitClicked"
                                    text="Créer mon compte" styleClass="btn-submit"/>

                            <HBox alignment="CENTER" styleClass="auth-footer-row">
                                <Label text="Déjà inscrit ? " styleClass="auth-footer-text"/>
                                <Hyperlink fx:id="linkGoToLogin" onAction="#onGoToLoginClicked"
                                           text="Se connecter" styleClass="auth-hyperlink-strong"/>
                            </HBox>
                        </VBox>
                    </VBox>
                </StackPane>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
